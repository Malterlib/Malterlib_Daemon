Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Daemon}"
{
	%Group "Daemon"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Daemon/^*"
		}
		%File "Source/*"
		%Group "Platform"
		{
			%File "Source/Platform/*"
			{
				Compile.Disabled true
				{
					!PlatformFamily PlatformFamilyFromImpFile
				}
			}
		}
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Daemon: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Daemon"
	{
		!!MalterlibLibrary_Daemon true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Daemon: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Daemon true
	}
}

%Group "{Test}/{Malterlib_Helper_Daemon}"
{
	Target
	{
		Type "Executable"
	}
	Property
	{
		MalterlibTestOwnMain true
	}
	%Group "Source"
	{
		%File "Test/Test_Malterlib_Daemon_Main.cpp"
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Helper_Daemon"
	MalterlibTestExtraGroups_Malterlib_Helper_Daemon: [string] = ["{Test}/{Malterlib_Helper_Daemon}"]
	MalterlibTestAutoAdd_Malterlib_Helper_Daemon: bool = false
}

%Group "{Test}/{Malterlib_Daemon}"
{
	%Group "Source"
	{
		%File "Test/Test_Malterlib_Daemon.cpp"
	}
	%Dependency {
		Name: "Exe_Test_Malterlib_Helper_Daemon"
		, Properties: {
			Dependency.Target: "Malterlib_Helper_Daemon"
		}
	}
	{
		Dependency.Link false
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Daemon"
	MalterlibTestExtraGroups_Malterlib_Daemon: [string] = ["{Test}/{Malterlib_Daemon}"]
}
